# Copy to .env and fill in. .env is gitignored; this file is not.

# Required
OPENROUTER_API_KEY=sk-or-...

# Optional. Defaults are shown.

# Model to call. Swapping models is a config change, not a code change.
PI_AGENT_MODEL=deepseek/deepseek-v4.1-flash

# "auto" runs every tool call without asking. "manual" prompts before writes
# and non-read-only commands. Overridden by --manual / --auto.
PI_AGENT_MODE=auto

# Max model round-trips per query before the loop stops.
PI_AGENT_MAX_TURNS=25

# Per-request HTTP timeout in ms, so a stalled provider cannot hang the harness.
PI_AGENT_TIMEOUT_MS=120000

# Optional sampling controls. Omit to use the provider defaults.
# PI_AGENT_MAX_TOKENS=4096
# PI_AGENT_TEMPERATURE=0.2
